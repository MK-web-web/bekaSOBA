# bekaSOBA — environment variables for production (set in Vercel → Settings → Environment Variables)

# Google Analytics 4 — Measurement ID (e.g. G-XXXXXXXXXX)
# Create at: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — HTML tag verification content value only (not the full meta tag)
# Create property at: https://search.google.com/search-console → HTML tag method
NEXT_PUBLIC_GSC_VERIFICATION=

# Formspree form endpoint (optional — defaults to the ID in ContactForm.tsx)
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
